# The address the waitlist form posts to: the "action" of the HTML form Brevo generates
# (Brevo > Contacts > Forms > the form > Share > HTML).
BREVO_FORM_ACTION=

# The legal name of the publisher of the site, shown on the privacy page.
PUBLISHER_NAME=

