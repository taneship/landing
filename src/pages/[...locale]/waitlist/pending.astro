---
import StatusMessage from '../../../components/StatusMessage.astro';
import { type Locale, localeStaticPaths, messagesOf } from '../../../i18n/locales';
import Page from '../../../layouts/Page.astro';
import { site } from '../../../site';

export const getStaticPaths = localeStaticPaths;

interface Props {
    locale: Locale;
}

// Brevo sends the visitor here once the form is submitted: see "Before going live" in README.md.
const { locale } = Astro.props;
const { waitlistPending } = messagesOf(locale);
---

<Page
    locale={locale}
    path="waitlist/pending"
    title={`${waitlistPending.title} — ${site.name}`}
    description={waitlistPending.description}
    indexed={false}
>
    <StatusMessage locale={locale} message={waitlistPending} />
</Page>
