---
import { Code } from 'astro:components';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';

import ButtonLink from '../../components/ButtonLink.astro';
import CheckIcon from '../../components/CheckIcon.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import FaqList from '../../components/FaqList.astro';
import { registerUserAction } from '../../components/home/code-excerpts';
import Terminal from '../../components/Terminal.astro';
import { formatDate, type Locale, localeStaticPaths, messagesOf } from '../../i18n/locales';
import Page from '../../layouts/Page.astro';
import { site } from '../../site';

export const getStaticPaths = localeStaticPaths;

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const { officialKitComparison: page, comparison, header } = messagesOf(locale);

// The name of this file is the path that site.ts gives to the links.
const path = site.officialKit.comparisonPath;
const url = getAbsoluteLocaleUrl(locale, path);
const homeUrl = getAbsoluteLocaleUrl(locale, '');
const home = getRelativeLocaleUrl(locale, '');

const officialKitUrl = `${site.officialKit.repositoryUrl}/tree/${site.officialKit.comparedCommit}`;
const note = page.note
    .replace('{date}', formatDate(locale, site.comparedOn))
    .replace('{commit}', site.officialKit.comparedCommit);

// One anchor per group of page.details.groups, in the same order and the same in every language.
const groupIds = [
    'stack',
    'authentication',
    'static-analysis',
    'tests',
    'rendering',
    'coding-agents',
    'continuous-integration',
];

if (page.details.groups.length !== groupIds.length) {
    throw new Error(`The comparison has ${groupIds.length} anchors: the "${locale}" text needs as many groups.`);
}

const groups = page.details.groups.map((group, index) => ({ ...group, id: groupIds[index] }));

const verdicts = [
    { ...page.verdict.taneship, name: comparison.taneship },
    { ...page.verdict.official, name: comparison.official },
];

const terminals = [
    {
        label: page.tryBoth.taneship,
        commands: site.createProjectCommands,
        caption: page.tryBoth.taneshipCaption,
    },
    {
        label: page.tryBoth.official,
        commands: ['laravel new my-app', 'cd my-app', 'composer dev'],
        caption: page.tryBoth.officialCaption,
    },
];

const publisher = { '@type': 'Organization', name: site.name, url: homeUrl };

const structuredData = [
    {
        '@context': 'https://schema.org',
        '@type': 'TechArticle',
        headline: page.title,
        description: page.meta.description,
        url,
        mainEntityOfPage: url,
        inLanguage: locale,
        image: new URL(`/og/${locale}.png`, Astro.site).href,
        datePublished: site.comparedOn.toISOString(),
        dateModified: site.comparedOn.toISOString(),
        author: publisher,
        publisher,
    },
    {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: site.name, item: homeUrl },
            { '@type': 'ListItem', position: 2, name: header.comparison, item: url },
        ],
    },
    {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        inLanguage: locale,
        mainEntity: page.faq.items.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
    },
];
---

<Page
    locale={locale}
    path={path}
    title={page.meta.title}
    description={page.meta.description}
    structuredData={structuredData}
>
    <article>
        <header class="mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16">
            <nav aria-label={page.breadcrumbLabel}>
                <ol class="flex items-center gap-2 text-sm text-muted-foreground">
                    <li><a href={home} class="hover:text-foreground">{site.name}</a></li>
                    <li aria-hidden="true">/</li>
                    <li aria-current="page" class="font-medium text-foreground">{header.comparison}</li>
                </ol>
            </nav>
            <h1 class="mt-6 max-w-4xl text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
                {page.title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg text-pretty text-muted-foreground">{page.lead}</p>
            <p class="mt-6 text-sm text-muted-foreground">{note}</p>
            <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                <li>
                    <a href={officialKitUrl} rel="noopener" class="font-medium underline underline-offset-4">
                        {page.sources.official}
                    </a>
                </li>
                <li>
                    <a href={site.repositoryUrl} rel="noopener" class="font-medium underline underline-offset-4">
                        {page.sources.taneship}
                    </a>
                </li>
            </ul>
        </header>

        <section id="verdict" class="border-y bg-muted/50">
            <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
                <h2 class="text-3xl font-semibold tracking-tight text-balance">{page.verdict.title}</h2>
                <div class="mt-10 grid gap-6 lg:grid-cols-2">
                    {
                        verdicts.map((verdict) => (
                            <section class="rounded-xl border bg-card p-6">
                                <p class="text-sm text-muted-foreground">{verdict.name}</p>
                                <h3 class="mt-1 text-xl font-semibold">{verdict.title}</h3>
                                <ul class="mt-5 space-y-3 text-sm">
                                    {verdict.items.map((item) => (
                                        <li class="flex gap-3">
                                            <CheckIcon class="mt-0.5" />
                                            {item}
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>
            </div>
        </section>

        <section id="shared" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
            <div class="max-w-2xl">
                <h2 class="text-3xl font-semibold tracking-tight text-balance">{page.shared.title}</h2>
                <p class="mt-4 text-lg text-muted-foreground">{page.shared.lead}</p>
            </div>
            <ul class="mt-10 grid gap-x-8 gap-y-3 sm:grid-cols-2">
                {
                    page.shared.items.map((item) => (
                        <li class="flex gap-3">
                            <CheckIcon class="mt-1" />
                            {item}
                        </li>
                    ))
                }
            </ul>
        </section>

        <section id="details" class="border-y bg-muted/50">
            <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
                <div class="max-w-2xl">
                    <h2 class="text-3xl font-semibold tracking-tight text-balance">{page.details.title}</h2>
                    <p class="mt-4 text-lg text-muted-foreground">{page.details.lead}</p>
                </div>
                <nav aria-label={page.details.title} class="mt-8">
                    <ul class="flex flex-wrap gap-2 text-sm">
                        {
                            groups.map((group) => (
                                <li>
                                    <a
                                        href={`#${group.id}`}
                                        class="inline-flex h-9 items-center rounded-lg border border-input bg-background px-3 font-medium hover:bg-accent"
                                    >
                                        {group.title}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>
                {
                    groups.map((group) => (
                        <section id={group.id} class="mt-16">
                            <h3 class="text-2xl font-semibold tracking-tight">{group.title}</h3>
                            <p class="mt-3 max-w-3xl text-muted-foreground">{group.text}</p>
                            <div class="mt-6">
                                <ComparisonTable locale={locale} label={group.title} rows={group.rows} />
                            </div>
                        </section>
                    ))
                }
            </div>
        </section>

        <section id="sign-up" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
            <div class="grid items-start gap-10 lg:grid-cols-2">
                <div>
                    <h2 class="text-3xl font-semibold tracking-tight text-balance">{page.signUp.title}</h2>
                    <p class="mt-6 text-muted-foreground">{page.signUp.official}</p>
                    <p class="mt-4 text-muted-foreground">{page.signUp.taneship}</p>
                </div>
                <figure class="min-w-0">
                    <div class="overflow-hidden rounded-xl border bg-card">
                        <p class="border-b px-4 py-3 font-mono text-xs text-muted-foreground">
                            app/Actions/RegisterUser.php
                        </p>
                        <Code
                            code={registerUserAction}
                            lang="php"
                            themes={{
                                light: 'github-light-high-contrast',
                                dark: 'github-dark-high-contrast',
                            }}
                            defaultColor={false}
                            class="overflow-x-auto p-4 text-sm leading-6"
                        />
                    </div>
                    <figcaption class="mt-3 text-sm text-muted-foreground">{page.signUp.caption}</figcaption>
                </figure>
            </div>
        </section>

        <section id="try" class="border-y bg-muted/50">
            <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
                <div class="max-w-2xl">
                    <h2 class="text-3xl font-semibold tracking-tight text-balance">{page.tryBoth.title}</h2>
                    <p class="mt-4 text-lg text-muted-foreground">{page.tryBoth.lead}</p>
                </div>
                <div class="mt-10 grid items-start gap-6 lg:grid-cols-2">
                    {
                        terminals.map((terminal) => (
                            <figure class="min-w-0">
                                <Terminal label={terminal.label} commands={terminal.commands} />
                                <figcaption class="mt-3 text-sm text-muted-foreground">
                                    {terminal.caption}
                                </figcaption>
                            </figure>
                        ))
                    }
                </div>
            </div>
        </section>

        <section id="faq" class="mx-auto max-w-3xl px-4 py-20 sm:px-6">
            <h2 class="text-3xl font-semibold tracking-tight text-balance">{page.faq.title}</h2>
            <div class="mt-10">
                <FaqList items={page.faq.items} />
            </div>
        </section>

        <section class="border-t">
            <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6">
                <h2 class="mx-auto max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
                    {page.closing.title}
                </h2>
                <p class="mx-auto mt-4 max-w-xl text-lg text-muted-foreground">{page.closing.text}</p>
                <div class="mt-8 flex flex-wrap justify-center gap-3">
                    <ButtonLink href={site.repositoryUrl} arrow>{page.closing.cta}</ButtonLink>
                    <ButtonLink href={home} variant="outline">{page.closing.home}</ButtonLink>
                </div>
            </div>
        </section>
    </article>
</Page>
