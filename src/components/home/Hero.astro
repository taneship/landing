---
import { type Locale, messagesOf } from '../../i18n/locales';
import { site } from '../../site';
import ButtonLink from '../ButtonLink.astro';
import CheckIcon from '../CheckIcon.astro';
import Terminal from '../Terminal.astro';

interface Props {
    locale: Locale;
}

const { hero, gates } = messagesOf(Astro.props.locale);
---

<section class="mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <div>
            <p class="text-sm font-medium text-muted-foreground">{hero.stack}</p>
            <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
                {hero.title}
            </h1>
            <p class="mt-6 text-lg text-pretty text-muted-foreground">{hero.lead}</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <ButtonLink href={site.repositoryUrl} arrow>{hero.useTemplate}</ButtonLink>
                <ButtonLink href="#waitlist" variant="outline">{hero.joinWaitlist}</ButtonLink>
            </div>
            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted-foreground">
                {
                    hero.reassurances.map((reassurance) => (
                        <li class="flex items-center gap-2">
                            <CheckIcon class="text-foreground" />
                            {reassurance}
                        </li>
                    ))
                }
            </ul>
        </div>

        <figure class="min-w-0">
            <Terminal label={hero.terminalLabel} commands={site.createProjectCommands} />
            <figcaption class="mt-3 text-sm text-muted-foreground">{hero.terminalCaption}</figcaption>
        </figure>
    </div>

    <h2 class="sr-only">{gates.title}</h2>
    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border bg-border lg:grid-cols-4">
        {
            gates.items.map((gate) => (
                <div class="flex flex-col-reverse justify-end gap-1 bg-background p-6">
                    <dt class="text-sm text-muted-foreground">{gate.label}</dt>
                    <dd class="text-3xl font-semibold tracking-tight">{gate.value}</dd>
                </div>
            ))
        }
    </dl>
</section>
