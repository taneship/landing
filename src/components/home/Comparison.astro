---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { formatDate, type Locale, messagesOf } from '../../i18n/locales';
import { site } from '../../site';
import ArrowIcon from '../ArrowIcon.astro';
import ComparisonTable from '../ComparisonTable.astro';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const { comparison } = messagesOf(locale);
---

<section id="comparison" class="border-y bg-muted/50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <div class="max-w-2xl">
            <h2 class="text-3xl font-semibold tracking-tight text-balance">{comparison.title}</h2>
            <p class="mt-4 text-lg text-muted-foreground">{comparison.lead}</p>
        </div>
        <div class="mt-12">
            <ComparisonTable locale={locale} label={comparison.title} rows={comparison.rows} />
        </div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-sm">
            <p class="text-muted-foreground">
                {comparison.note.replace('{date}', formatDate(locale, site.comparedOn))}
            </p>
            <a
                href={getRelativeLocaleUrl(locale, site.officialKit.comparisonPath)}
                class="inline-flex items-center gap-1.5 font-medium underline underline-offset-4"
            >
                {comparison.fullComparison}
                <ArrowIcon />
            </a>
        </div>
    </div>
</section>
