---
import { formatDate, type Locale, messagesOf } from '../../i18n/locales';
import { site } from '../../site';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const { comparison } = messagesOf(locale);
---

<section id="comparison" class="border-y bg-muted/50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <div class="max-w-2xl">
            <h2 class="text-3xl font-semibold tracking-tight text-balance">{comparison.title}</h2>
            <p class="mt-4 text-lg text-muted-foreground">{comparison.lead}</p>
        </div>
        <div class="mt-12 overflow-x-auto rounded-xl border bg-card" tabindex="0" role="region" aria-label={comparison.title}>
            <table class="w-full min-w-[40rem] text-left text-sm">
                <thead>
                    <tr class="border-b">
                        <th scope="col" class="w-1/4 p-4 font-medium text-muted-foreground">
                            {comparison.criterion}
                        </th>
                        <th scope="col" class="p-4 font-semibold">{comparison.taneship}</th>
                        <th scope="col" class="p-4 font-medium text-muted-foreground">
                            {comparison.official}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {
                        comparison.rows.map((row) => (
                            <tr class="border-b last:border-b-0">
                                <th scope="row" class="p-4 font-medium text-muted-foreground">
                                    {row.criterion}
                                </th>
                                <td class="p-4 font-medium">{row.taneship}</td>
                                <td class="p-4 text-muted-foreground">{row.official}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>
        <p class="mt-4 text-sm text-muted-foreground">
            {comparison.note.replace('{date}', formatDate(locale, site.comparedOn))}
        </p>
    </div>
</section>
