---
import { Code } from 'astro:components';

import { type Locale, messagesOf } from '../../i18n/locales';
import { actionsArchitectureTest, registerUserAction } from './code-excerpts';

interface Props {
    locale: Locale;
}

const { guardrails } = messagesOf(Astro.props.locale);

const excerpts = [
    {
        file: 'app/Actions/RegisterUser.php',
        code: registerUserAction,
        caption: guardrails.actionCaption,
    },
    {
        file: 'tests/Unit/Arch/ClassesTest.php',
        code: actionsArchitectureTest,
        caption: guardrails.architectureTestCaption,
    },
];
---

<section id="quality" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight text-balance">{guardrails.title}</h2>
        <p class="mt-4 text-lg text-muted-foreground">{guardrails.lead}</p>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
            guardrails.items.map((guardrail) => (
                <li class="rounded-xl border bg-card p-6">
                    <h3 class="font-semibold">{guardrail.title}</h3>
                    <p class="mt-2 text-sm text-muted-foreground">{guardrail.text}</p>
                </li>
            ))
        }
    </ul>

    <div class="mt-20 max-w-2xl">
        <h3 class="text-2xl font-semibold tracking-tight">{guardrails.codeTitle}</h3>
        <p class="mt-3 text-muted-foreground">{guardrails.codeLead}</p>
    </div>
    <div class="mt-8 grid items-start gap-6 lg:grid-cols-2">
        {
            excerpts.map((excerpt) => (
                <figure class="min-w-0">
                    <div class="overflow-hidden rounded-xl border bg-card">
                        <p class="border-b px-4 py-3 font-mono text-xs text-muted-foreground">
                            {excerpt.file}
                        </p>
                        <Code
                            code={excerpt.code}
                            lang="php"
                            themes={{
                                light: 'github-light-high-contrast',
                                dark: 'github-dark-high-contrast',
                            }}
                            defaultColor={false}
                            class="overflow-x-auto p-4 text-sm leading-6"
                        />
                    </div>
                    <figcaption class="mt-3 text-sm text-muted-foreground">{excerpt.caption}</figcaption>
                </figure>
            ))
        }
    </div>
</section>
