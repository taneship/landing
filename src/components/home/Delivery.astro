---
import { type Locale, messagesOf } from '../../i18n/locales';

interface Props {
    locale: Locale;
}

const { delivery } = messagesOf(Astro.props.locale);
---

<section class="border-y bg-muted/50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
        <div class="max-w-2xl">
            <h2 class="text-3xl font-semibold tracking-tight text-balance">{delivery.title}</h2>
            <p class="mt-4 text-lg text-muted-foreground">{delivery.lead}</p>
        </div>
        <ol class="mt-12 grid gap-8 md:grid-cols-3">
            {
                delivery.steps.map((step, index) => (
                    <li class="flex gap-4">
                        <span
                            class="flex size-9 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground"
                            aria-hidden="true"
                        >
                            {index + 1}
                        </span>
                        <div>
                            <h3 class="font-semibold">{step.title}</h3>
                            <p class="mt-2 text-sm text-muted-foreground">{step.text}</p>
                        </div>
                    </li>
                ))
            }
        </ol>
    </div>
</section>
