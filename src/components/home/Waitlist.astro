---
import { getRelativeLocaleUrl } from 'astro:i18n';

import { type Locale, messagesOf } from '../../i18n/locales';
import { deployment } from '../../site';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const { waitlist } = messagesOf(locale);
---

<section id="waitlist" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="mx-auto max-w-xl rounded-2xl border bg-card p-6 sm:p-10">
        <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{waitlist.title}</h2>
        <p class="mt-3 text-muted-foreground">{waitlist.lead}</p>

        {/* The field names are those of a Brevo subscription form: the form posts straight to it. */}
        <form method="post" action={deployment.waitlistFormAction} class="mt-8 space-y-4">
            <div>
                <label for="waitlist-email" class="text-sm font-medium">{waitlist.emailLabel}</label>
                <input
                    id="waitlist-email"
                    type="email"
                    name="EMAIL"
                    required
                    autocomplete="email"
                    placeholder={waitlist.emailPlaceholder}
                    class="mt-2 block h-11 w-full rounded-lg border border-input bg-background px-3 text-base placeholder:text-muted-foreground"
                />
            </div>
            <label class="flex items-start gap-3 text-sm">
                <input type="checkbox" name="OPT_IN" value="1" required class="mt-0.5 size-4 accent-primary" />
                <span>{waitlist.consent}</span>
            </label>
            {/* Brevo's honeypot: a person leaves it empty. */}
            <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" hidden />
            <input type="hidden" name="locale" value={locale} />
            <button
                type="submit"
                class="inline-flex h-11 w-full cursor-pointer items-center justify-center rounded-lg bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/85"
            >
                {waitlist.submit}
            </button>
        </form>

        <p class="mt-6 text-sm text-muted-foreground">
            {waitlist.notice}{' '}
            <a href={getRelativeLocaleUrl(locale, 'privacy')} class="font-medium text-foreground underline underline-offset-4">
                {waitlist.privacy}
            </a>
        </p>
    </div>
</section>
