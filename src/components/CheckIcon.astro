---
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class:list={['size-4 shrink-0', className]}
    aria-hidden="true"
>
    <path d="M20 6 9 17l-5-5"></path>
</svg>
