---
import { getRelativeLocaleUrl } from 'astro:i18n';

import type { Locale } from '../i18n/locales';

interface Props {
    locale: Locale;
    message: { title: string; description: string; hint: string; back: string };
}

const { locale, message } = Astro.props;
---

<section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{message.title}</h1>
    <p class="mt-4 text-lg text-pretty text-muted-foreground">{message.description}</p>
    <p class="mt-4 text-sm text-pretty text-muted-foreground">{message.hint}</p>
    <p class="mt-10">
        <a href={getRelativeLocaleUrl(locale, '')} class="font-medium underline underline-offset-4">
            {message.back}
        </a>
    </p>
</section>
