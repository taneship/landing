---
interface Props {
    label: string;
    commands: readonly string[];
}

const { label, commands } = Astro.props;
---

<div class="overflow-hidden rounded-xl border bg-card shadow-sm">
    <div class="flex items-center gap-2 border-b px-4 py-3">
        <span class="size-3 rounded-full bg-border"></span>
        <span class="size-3 rounded-full bg-border"></span>
        <span class="size-3 rounded-full bg-border"></span>
        <span class="ml-2 text-xs text-muted-foreground">{label}</span>
    </div>
    <pre
        tabindex="0"
        aria-label={label}
        class="overflow-x-auto p-4 font-mono text-sm leading-7"><code>{commands.map((command) => (
            <span class="block before:mr-3 before:text-muted-foreground before:content-['$']">{command}</span>
        ))}</code></pre>
</div>
